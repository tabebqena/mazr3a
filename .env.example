# ============================================================
# Camera credentials — copy this file to .env and EDIT THE VALUES.
#   cp .env.example .env
#
# Frigate 0.17 resolves these in config/config.yaml via {FRIGATE_...}
# placeholders (Python str.format() applied to the camera input path,
# using only FRIGATE_-prefixed env vars). The old !env_var YAML tag is
# NOT supported in 0.17 — if used, the literal text stays in the URL.
#
# IMPORTANT: the FRIGATE_ prefix is REQUIRED. docker-compose.yml loads
# this file into the frigate container via `env_file: .env`, and Frigate
# only substitutes variables whose names start with FRIGATE_.
#
# .env is git-ignored (see .gitignore) — never commit real passwords.
# ============================================================

# RTSP username shared by the 9 UNV cameras (typically "admin")
FRIGATE_RTSP_USER=admin

# RTSP password shared by the 9 UNV cameras
FRIGATE_RTSP_PASS=CHANGE_ME

# ------------------------------------------------------------------
# Hikvision cam08 (192.168.1.207) uses SEPARATE credentials - its admin
# password differs from the UNV cameras. Without these, cam08 fails
# with "DESCRIBE failed: 401 Unauthorized" and crash-loops.
# Set the REAL Hikvision user/password here.
# ------------------------------------------------------------------
FRIGATE_HIK_RTSP_USER=admin
FRIGATE_HIK_RTSP_PASS=CHANGE_ME
