# Secrets - never commit camera credentials
.env
config/telegram.conf
# Portal user credentials + session secret (example committed as portal.conf.example)
config/portal.conf

# Frigate media (recordings, snapshots, cache)
media/

# Mosquitto runtime data and logs
mosquitto/data/
mosquitto/log/

# Frigate runtime logs (diagnostic artifact, not source)
frigate.log

# SQLite databases (added in later phases)
*.db
*.db-wal
*.db-shm

# Fire-watch ACTIVE model is TRACKED in git (2026-09-05, git-deploy decision):
# models/fire/best.xml / best.bin / best.pt / labelmap.txt ride the deploy via
# `git pull`, so firewatch on the host always matches the repo. Provenance:
# models/fire/README.md. Do NOT ignore the ACTIVE set again while git deploys.
# Versioned fire-model archive (one dir per version: model.pt + VERSION.json).
# Large + machine-local - see tracked models/fire/VERSIONS.md for the registry.
# The versions/ archive stays git-ignored and never ships to the host.
models/fire/versions/

# Local finetuned CANDIDATE that is not verified / not provenanced (appeared as
# untracked `??` in git status). Keep it out of `git add .`. Only VERIFIED
# releases ride models/fire/best.* - see models/fire/VERSIONS.md.
# NOTE: do NOT ignore the ACTIVE set or the models/ tree - the git deploy
# (dev_scripts/deploy_all.sh) ships them via `git pull`; see the comment above.
models/fire/best_v5_finetuned_not_verified.pt

# Frigate COCO detector model (person/car/animal) is TRACKED in git at
# models/coco/ (2026-09-06): yolo11n.onnx ACTIVE + yolov8s.onnx alternative +
# labelmap.txt ride the git deploy; frigate loads them from /models/coco via the
# ./models:/models:ro mount. config/ holds ONLY config (no models).

# models/scene/ is GIT-IGNORED (2026-09-10): the models there are far too large
# for git history (unlike the 20 MB models/fire/ ACTIVE set). TWO models live
# there and BOTH are fetched onto the host as a deploy prerequisite:
#   * the SMALL default - SmolVLM2 GGUF + mmproj under
#     models/scene/smolvlm2-500m/, plus the llama.cpp binaries in
#     models/scene/bin/  -> dev_scripts/prep_scene_model_llamacpp.sh
#   * the RETAINED larger - the Qwen2-VL-2B int4 OpenVINO IR directly in
#     models/scene/. It is KEPT deliberately (never deleted, never
#     re-downloaded) so MODEL_BACKEND=openvino can be flipped back on.
# Provenance: models/scene/README.md + VERSIONS.md (tracked).
models/scene/*
!models/scene/README.md
!models/scene/VERSIONS.md

# ------------------------------------------------------------------
# Host Frigate runtime files that Frigate ITSELF writes into config/ on the
# host (verified on ssh.mazr3a.garden 2026-09-06) - auto-generated, never
# authored or committed. Ignoring them keeps the config/ dir = only the config
# files we version, and the host clone's `git status` clean. frigate.db /
# backup.db are already covered by `*.db` above.
# ------------------------------------------------------------------
config/model_cache/
config/.exports/
config/.jwt_secret
config/.search_stats.json
config/.timeline/
config/.vacuum
config/go2rtc_homekit.yml

# media-cleanup.log is written to the deploy root by the host cleanup cron
# (scripts/cleanup_media.sh -> cleanup_media.conf LOG_FILE). Host-only runtime log.
# RETIRED 2026-09-09: the unified heartbeat (scripts/heartbeat_cleanup.py ->
# config/heartbeat.conf LOG_FILE) replaces cleanup_media.sh; its own log is
# heartbeat-cleanup.log (also at the deploy root).
media-cleanup.log
heartbeat-cleanup.log

# machine-monitor.state is written to the deploy root by the host watchdog cron
# (scripts/machine-monitor.py -> MONITOR_STATE). Host-only debounce state.
machine-monitor.state

# Python bytecode caches
__pycache__/
*.pyc

# Ultralytics run output (training/val artifacts written to ./runs by default)
runs/

# Local fire/smoke model eval virtualenv(s) (see plans/fire-model-dataset-test.md)
.venv*

# OS / editor noise
.DS_Store
*.swp
.roo/rules/sshuser.md

# Curated fire/smoke dataset material - all large + derived and excluded from
# training as appropriate. Includes the ready_fire_smoke export, the no-label
# images staged by dev_scripts/find_unlabelled_images.py (fire-model-training/unlabelled-images-dir),
# the curated negatives (fire-model-training/default-other) and eval artifacts.
fire-model-training/*
model-training/*


# Firewatch alert clip exports (Frigate recordings around registered fire alerts) -
# large media artifacts, not source. Host staging dir (/home/dr/frigate/firewatch_clips)
# and the local download mirror (./firewatch-fire-clips). See plans/firewatch-clip-export.md.
firewatch_clips/
firewatch-fire-clips/

# Camera clip exports (Frigate recording segments scoped by camera, for
# firewatch model testing + scene-reader fine-tuning) - large media artifacts,
# not source. Host staging dir (/home/dr/frigate/cam-clips) and the local
# download mirror (./camera-clips). See plans/camera-clip-export.md.
cam-clips/
camera-clips/

