# Secrets - never commit camera credentials
.env
config/telegram.conf

# Frigate media (recordings, snapshots, cache)
media/

# Mosquitto runtime data and logs
mosquitto/data/
mosquitto/log/

# Frigate runtime logs (diagnostic artifact, not source)
frigate.log

# SQLite databases (added in later phases)
*.db
*.db-wal
*.db-shm

# Fire-watch OpenVINO IR model binaries (large, acquired once - see
# models/fire/README.md for provenance; README.md and labelmap.txt stay tracked)
models/fire/*.xml
models/fire/*.bin

# Python bytecode caches
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
*.swp
.roo/rules/sshuser.md
