# Secrets - never commit camera credentials
.env
config/telegram.conf

# Frigate media (recordings, snapshots, cache)
media/

# Mosquitto runtime data and logs
mosquitto/data/
mosquitto/log/

# Frigate runtime logs (diagnostic artifact, not source)
frigate.log

# SQLite databases (added in later phases)
*.db
*.db-wal
*.db-shm

# Fire-watch ACTIVE model is TRACKED in git (2026-09-05, git-deploy decision):
# models/fire/best.xml / best.bin / best.pt / labelmap.txt ride the deploy via
# `git pull`, so firewatch on the host always matches the repo. Provenance:
# models/fire/README.md. Do NOT ignore the ACTIVE set again while git deploys.
# Versioned fire-model archive (one dir per version: model.pt + VERSION.json).
# Large + machine-local - see tracked models/fire/VERSIONS.md for the registry.
# The versions/ archive stays git-ignored and never ships to the host.
models/fire/versions/

# Frigate COCO detector model (person/car/animal) is TRACKED in git at
# models/coco/ (2026-09-06): yolo11n.onnx ACTIVE + yolov8s.onnx alternative +
# labelmap.txt ride the git deploy; frigate loads them from /models/coco via the
# ./models:/models:ro mount. config/ holds ONLY config (no models) - and host
# runtime junk Frigate writes into config/ (frigate.db, backup.db, model_cache)
# stays ignored, never committed.
config/model_cache/

# Python bytecode caches
__pycache__/
*.pyc

# Ultralytics run output (training/val artifacts written to ./runs by default)
runs/

# Local fire/smoke model eval virtualenv(s) (see plans/fire-model-dataset-test.md)
.venv*

# OS / editor noise
.DS_Store
*.swp
.roo/rules/sshuser.md

# Curated fire/smoke dataset material - all large + derived and excluded from
# training as appropriate. Includes the ready_fire_smoke export, the no-label
# images staged by dev_scripts/find_unlabelled_images.py (dataset/unlabelled-images-dir),
# the curated negatives (dataset/default-other) and eval artifacts.
dataset/*

# ------------------------------------------------------------------
# Local working docs (not versioned): all plan files (plans/), the master
# prompt (prompt.txt) and Colab notebooks (notebooks/, regenerable from
# dev_scripts/build_fire_large_colab_nb.py). They live on this machine only;
# the git remote + deploy tree do not need them.
# ------------------------------------------------------------------
plans/
prompt.txt
notebooks/