# Secrets - never commit camera credentials
.env
config/telegram.conf

# Frigate media (recordings, snapshots, cache)
media/

# Mosquitto runtime data and logs
mosquitto/data/
mosquitto/log/

# Frigate runtime logs (diagnostic artifact, not source)
frigate.log

# SQLite databases (added in later phases)
*.db
*.db-wal
*.db-shm

# Fire-watch model artifacts (large, acquired once - see models/fire/README.md
# for provenance; README.md stays tracked)
models/fire/*.xml
models/fire/*.bin
models/fire/*.pt

# COCO YOLO replacement model artifacts (large, exported once - see
# models/coco/README.md for provenance; README.md + labelmap.txt stay tracked)
models/coco/*.onnx
models/coco/*.pt

# Python bytecode caches
__pycache__/
*.pyc

# Ultralytics run output (training/val artifacts written to ./runs by default)
runs/

# Local fire/smoke model eval virtualenv(s) (see plans/fire-model-dataset-test.md)
.venv*

# OS / editor noise
.DS_Store
*.swp
.roo/rules/sshuser.md


dataset/*