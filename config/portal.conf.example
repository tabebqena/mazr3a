# ============================================================
# portal - web portal (FastAPI + SPA) tunables for the Frigate +
# Firewatch stack. Copy to config/portal.conf (git-ignored) and
# EDIT THE VALUES, then recreate the portal container:
#     cp config/portal.conf.example config/portal.conf
#     docker compose up -d --force-recreate portal
#
# Consumed read-only at /config/portal.conf by the `portal`
# container (mounted ./config). Every option can be overridden by a
# same-named environment variable prefixed PORTAL_ (which wins).
# ============================================================

# ------------------------------------------------------------------
# Users - RUNTIME accounts live in the portal's own SQLite DB
# (PORTAL_USERS_DB, default /media/portal/users.db). Add / edit / delete them
# from the portal Account tab - a change applies IMMEDIATELY, with NO container
# restart. The `user` lines below are only a FIRST-RUN SEED (used to bootstrap
# an existing deployment / an initial admin); after that the DB is the source of
# truth and these lines are ignored.
#
# This is the app-level gate (the Cloudflare Access policy already protects the
# network in front). Generate a seed hash line with:
#     python portal/genpass.py --username admin        # prompts (hidden)
# Format: user <name> <pbkdf2$iters$salt$hash> [default_camera=<cam>]
# The user literally named `admin` is seeded as the first administrator.
# ------------------------------------------------------------------
# user admin pbkdf2$600000$<salt_hex>$<hash_hex> default_camera=cam01

# Runtime user DB (portal/userstore.py). The dir is created on demand under the
# rw ./media mount; the same dir already holds the bandwidth usage DB.
PORTAL_USERS_DB=/media/portal/users.db

# Signs session cookies. REQUIRED - use a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Session cookie lifetime (days) and whether the cookie is Secure-only.
# Secure=true matches the public HTTPS origin (Cloudflare Tunnel). Set
# false only for plain-HTTP LAN testing.
SESSION_DAYS=7
COOKIE_SECURE=true

# Live-view idle time watch: stop the stream after this many seconds of
# user inactivity (mouse/touch/keyboard resets the clock). The SPA shows a
# resume overlay. This is the single source of truth for ALL users - there is
# no in-UI control; change it here (an admin edit) and recreate/restart the
# portal container. The stream also stops when the browser tab is hidden.
STREAM_IDLE_TIMEOUT_S=30

# Landing camera when the user has no per-user default_camera. Empty =
# first camera returned by Frigate.
DEFAULT_CAMERA=cam01

# ------------------------------------------------------------------
# Per-user bandwidth accounting (Live + Events video). The portal is the
# egress chokepoint for Live (MSE/HLS), event clips and snapshots, so it
# counts the real bytes it sends each logged-in user. Totals are DAILY
# counters keyed by user + day + kind (live | events | other); each user
# sees their own totals and the admin sees everyone (Usage tab).
#
# PORTAL_USAGE_DB - SQLite path (in the portal container). Default is under
#   the rw ./media mount; the dir is created on demand.
# USAGE_RETENTION_DAYS - history kept; rows older than this are pruned
#   in-app (the host disk heartbeat hard-protects *.db and cannot prune rows).
# ------------------------------------------------------------------
PORTAL_USAGE_DB=/media/portal/usage.db
USAGE_RETENTION_DAYS=180

# Frigate REST API base (compose service name inside the network). Only
# reached server-side; Frigate is never exposed to browsers directly.
FRIGATE_API=http://frigate:5000

# ------------------------------------------------------------------
# LIVE VIEW = HLS (primary) with a detect-snapshot fallback.
# The SPA plays SAME-ORIGIN HLS through the portal with hls.js:
# /api/live/<cam>/hls/stream.m3u8 -> Frigate's embedded go2rtc HLS (go2rtc
# must have the cameras registered via a `go2rtc.streams` block in
# config/config.yaml, using {FRIGATE_*} python-format credentials; go2rtc in
# this Frigate has no MSE). Same-origin means it stays behind the portal
# session cookie and works through the Cloudflare Tunnel with no extra path
# mapping. No stream URL template is required. If HLS is unavailable, Live
# falls back to /api/live/<cam>/latest.jpg (~1 fps detect snapshot).
#
# Firewatch evidence store (read-only consumer of the WAL DB).
# The host ./media tree is mounted at /media in the portal container;
# firewatch sees the same tree at /media/firewatch (STORE_DIR), so its
# stored jpg_path /media/firewatch/<cam>/x.jpg is served from
# /media/<cam>/x.jpg via the PREFIX -> REPLACE remap below.
# ------------------------------------------------------------------
FIREWATCH_DB=/media/firewatch.db
FIREWATCH_JPG_PREFIX=/media/firewatch/
FIREWATCH_JPG_REPLACE=/media/

# ------------------------------------------------------------------
# scenewatch scene-description store (read-only consumer, "Scenes" tab).
# scenewatch writes STORE_DIR=/media/scenewatch - its own subdir of the same
# host ./media tree this container mounts at /media - so its stored absolute
# jpg_path (/media/scenewatch/<cam>/x.jpg) needs NO prefix remap.
# SCENE_JPG_ROOT is the safety guard: a stored image is served only when it
# resolves INSIDE this directory.
# ------------------------------------------------------------------
SCENE_DB=/media/scenewatch/scenewatch.db
SCENE_JPG_ROOT=/media/scenewatch
