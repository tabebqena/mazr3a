# ============================================================
# Telegram alerting - credentials & tunables (TEMPLATE).
#
# Copy to telegram.conf and EDIT THE VALUES, then deploy it to
# the host alongside the scripts:
#     cp config/telegram.conf.example config/telegram.conf
#     nano config/telegram.conf          # set BOT_TOKEN + CHAT_ID
#     scp config/telegram.conf ai@ssh.mazr3a.garden:/home/dr/frigate/config/
#
# Used by (the host scripts read this same config/telegram.conf):
#     scripts/machine-monitor.py   debounced high-CPU-temperature alerts
#     scripts/machine-status.py    daily machine health report
#     firewatch/firewatch.py       fire/smoke alert photos (container mount)
#     scripts/telegram_bot.py      on-demand /status responder (docker service)
#
# telegram.conf is git-ignored (see .gitignore) - never commit
# the real bot token. If you edit the values on the host only,
# keep the local copy in sync so deploys do not clobber it.
# ============================================================

# Telegram bot token (create a bot with @BotFather on Telegram).
BOT_TOKEN=CHANGE_ME

# Recipient chat id(s) - where notifications are posted. ONE bot can post to
# MANY chats: put every destination here, comma-separated (a single id works
# too). Each id may be a private user id, a group id, or a channel id, e.g.
#     CHAT_ID=7844679766,-5402647496
# To add a recipient:
#   * Private user  - they must open the bot and press Start first (a bot cannot
#                     message someone who never started it).
#   * Group         - add the bot to the group as a member, then post a message
#                     there so the group id shows up in getUpdates.
#   * Channel       - add the bot to the channel as an ADMINISTRATOR (otherwise
#                     it cannot post).
#   * Reading an id - from the target chat, forward one of the bot's messages to
#                     @RawDataBot (it replies with the chat.id), or call
#                     https://api.telegram.org/bot<TOKEN>/getUpdates and read
#                     message.chat.id. Group/channel ids are negative (supergroups
#                     and channels start with -100).
CHAT_ID=CHANGE_ME

# ------------------------------------------------------------------
# machine-monitor.py tunables (CPU-temperature watchdog).
#
#   MAX_TEMP      CPU temp in °C at/above which the watchdog starts counting.
#   MIN_HITS      number of samples that must all be at/above MAX_TEMP...
#   MIN_INTERVAL  ...with at least this many MINUTES between samples, before
#                 an alert is sent.
#
# Defaults if a key is unset: MAX_TEMP=75, MIN_HITS=3, MIN_INTERVAL=30 ->
# the script collects sensors 3 times with 30 minutes in between; only when
# the max sensor temperature is still above MAX_TEMP does it send (a single
# transient spike is ignored).
# ------------------------------------------------------------------
MAX_TEMP=75
MIN_HITS=3
MIN_INTERVAL=30

# ------------------------------------------------------------------
# telegram-bot tunables (on-demand /status command responder - docker
# service, see scripts/telegram_bot.py + docker-compose.yml).
#
#   ALLOWED_USER_IDS  comma-separated Telegram user ids allowed to run
#                     commands (/status etc.). UNSET/empty (default) = any
#                     message coming from one of the CHAT_ID recipients is
#                     answered (e.g. any member of the farm group). Set it to
#                     the owner id to restrict commands to specific people in
#                     ANY chat:
#                         ALLOWED_USER_IDS=7844679766
#
# Commands (send in the group, or privately to the bot; in a group with
# several bots use /status@<botname>):
#     /status   live host + Frigate health report
#     /help     help text
#     /start    greeting
#
# The bot long-polls getUpdates as the telegram-bot service - do NOT run
# manual getUpdates/curl while it is up (that would cause HTTP 409 conflicts).
# ------------------------------------------------------------------
# ALLOWED_USER_IDS=7844679766
