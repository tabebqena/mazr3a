# ============================================================
# Frigate host cron jobs: media cleanup + Telegram monitoring.
#
# Install (overwrites the whole crontab):
#     crontab scripts/crontab.sample
# or merge the lines into an existing crontab:
#     crontab -e
#
# Each job handles its own logging/alerting, so cron output is
# sent to /dev/null. Adjust /home/dr/frigate if the host deploy
# dir differs.
# ============================================================

# Media disk-cap cleanup (bash) - every 30 minutes
# (logs to config/cleanup_media.conf -> LOG_FILE)
*/30 * * * * /home/dr/frigate/scripts/cleanup_media.sh >> /dev/null 2>&1

# CPU temperature watchdog (python) - every 10 minutes
# Debounced Telegram alert: only when the CPU stays >= MAX_TEMP for MIN_HITS
# samples >= MIN_INTERVAL minutes apart (tunables in config/telegram.conf;
# debounce state persists in machine-monitor.state).
*/10 * * * * /usr/bin/python3 /home/dr/frigate/scripts/machine-monitor.py >> /dev/null 2>&1

# Daily machine health report (python) - 08:00 every day
# (Telegram summary of host + Frigate state, per-camera online/offline)
0 8 * * * /usr/bin/python3 /home/dr/frigate/scripts/machine-status.py >> /dev/null 2>&1
