# ============================================================
# Frigate host cron jobs: media cleanup + Telegram monitoring.
#
# Install (overwrites the whole crontab):
#     crontab scripts/crontab.sample
# or merge the lines into an existing crontab:
#     crontab -e
#
# Each job handles its own logging/alerting, so cron output is
# sent to /dev/null. Adjust /home/dr/frigate if the host deploy
# dir differs.
# ============================================================

# Media disk-cap cleanup (bash) - every 30 minutes
# (logs to config/cleanup_media.conf -> LOG_FILE)
*/30 * * * * /home/dr/frigate/scripts/cleanup_media.sh >> /dev/null 2>&1

# CPU temperature watchdog (python) - EVERY MINUTE (was */10)
# Two-tier Telegram alert (tunables in config/telegram.conf):
#   * CRITICAL: any single sample >= CRITICAL_TEMP (default 80 °C) alerts at once.
#   * WARM: MIN_HITS samples >= MAX_TEMP within MIN_WINDOW_MIN alert (default
#     72 °C, 3 in 240 min). History persists in machine-monitor.state.
# Every-minute sampling is REQUIRED: this host's hot spikes last ~1 min and a
# 10-min cadence missed the 83 °C peak (2026-09-08). If you edit this file's
# cadence, re-apply the whole crontab (crontab scripts/crontab.sample).
* * * * * /usr/bin/python3 /home/dr/frigate/scripts/machine-monitor.py >> /dev/null 2>&1

# Daily machine health report (python) - 08:00 every day
# (Telegram summary of host + Frigate state, per-camera online/offline)
0 8 * * * /usr/bin/python3 /home/dr/frigate/scripts/machine-status.py >> /dev/null 2>&1

# Machine+Frigate state watchdog (python) - every minute
# Cron mode (scripts/watchdog_baseline.py --cron): appends one sample per tick
# to a persistent, size-capped CSV (default <deploy>/media/watchdog/; falls back
# to ~/watchdog when the deploy dir isn't writable by the cron owner). Use a
# distinct --tag per comparison window - e.g. "baseline_pre" before a stream
# quality change, then "after_bump" once it's applied. CSV rows are bounded by
# --max-rows (default 20000).
* * * * * /usr/bin/python3 /home/dr/frigate/scripts/watchdog_baseline.py --cron --tag baseline_pre >> /dev/null 2>&1

# Firewatch evidence-store cleanup (python, run INSIDE the firewatch container)
# - every 30 minutes. Caps stored firewatch JPEGs at MAX_IMAGES_GB (default 2)
# and expires DB rows older than ROW_EXPIRE_DAYS (default 90 = 3 months).
# Tunables: config/cleanup_firewatch.conf (mounted at /config in the container).
# Runs as the firewatch user (uid 1000, owner of the evidence files) via docker
# exec, so it can delete rows + images; it never touches Frigate's media files.
*/30 * * * * /usr/bin/docker exec firewatch python /scripts/cleanup_firewatch_store.py >> /dev/null 2>&1
